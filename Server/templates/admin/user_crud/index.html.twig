{% extends 'admin/base.html.twig' %}

{% block title %}Users — SmartDisc Admin{% endblock %}

{% block admin_body %}
    <div class="admin-actions-row">
        <div>
            <p class="admin-eyebrow">Manage</p>
            <h1 class="admin-title" style="margin-bottom: 0;">Admins</h1>
        </div>
    </div>

    <div class="admin-card">
        <form class="admin-form" method="post" action="{{ path('app_admin_user_crud_promote') }}">
            <div>
                <label for="promote-email">Email</label>
                <input type="email" id="promote-email" name="email" placeholder="user@example.com" required>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('promote_by_email') }}">
            <button class="admin-btn" type="submit">Promote to admin</button>
        </form>
    </div>

    {% if admins|length == 0 %}
        <div class="admin-card admin-empty">No admins yet.</div>
    {% else %}
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for user in admins %}
                <tr>
                    <td>{{ user.email }}</td>
                    <td class="admin-table__actions">
                        {{ include('admin/user_crud/_demote_form.html.twig') }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
